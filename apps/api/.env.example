# Copy to .env and adjust. Never commit the real .env file.
APP_NAME=Inventra
ENVIRONMENT=development

DATABASE_URL=postgresql+psycopg://inventra:inventra_dev@localhost:5432/inventra
TEST_DATABASE_URL=postgresql+psycopg://inventra:inventra_dev@localhost:5432/inventra_test

# Comma-separated list of web origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5173

# Address of the web app, used to build links in emails (e.g. email verification).
WEB_APP_URL=http://localhost:5173

# Sending emails (verification, password reset, invitations) through Brevo's SMTP.
# Leave SMTP_HOST empty to print emails in the terminal instead of sending them.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=Inventra <noreply@inventra.day>
