// Cloudflare Workers: builds and serves the web app on inventra.day.
// Cloudflare runs `npm run build`, then `npx wrangler deploy` with this file.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "inventra",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    // Where Vite writes the finished site.
    "directory": "./dist",
    "binding": "ASSETS",
    // /products/12 is not a file: every unknown address gets index.html and React Router
    // decides what to show.
    "not_found_handling": "single-page-application",
    // Only these addresses run the worker; every other file is served straight away, for free.
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "API_ORIGIN": "https://api.inventra.day"
  },
  "routes": [{ "pattern": "inventra.day", "custom_domain": true }],
  "observability": { "enabled": true }
}
