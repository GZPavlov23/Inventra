# Copy to .env and adjust. Never commit the real .env file.
APP_NAME=Inventra
ENVIRONMENT=development

DATABASE_URL=postgresql+psycopg://inventra:inventra_dev@localhost:5432/inventra
TEST_DATABASE_URL=postgresql+psycopg://inventra:inventra_dev@localhost:5432/inventra_test

# Comma-separated list of web origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5173

# TEMPORARY (until authentication in Milestone 2): every request acts on this store.
DEV_STORE_ID=1
